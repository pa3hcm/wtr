#!/usr/bin/env python3

"""
This program queries the Rijkswaterstaat Waterinfo API to get data like actual water levels.
It access the 'Water Webservices API', which is documented here:
https://rijkswaterstaatdata.nl/waterdata/
"""


import json
import os
import sqlite3
import sys
import argparse
import datetime
from requests import post


VERSION = "v0.5b"
API = "https://ddapi20-waterwebservices.rijkswaterstaat.nl/"


def get_cache_db_filename():
    """
    Generate a file name for the cache database which is unique for the current user
    """
    cache_db_filename = os.environ.get("WTR_CACHE") or f"/tmp/.wtr_cache_{os.getlogin()}.db"
    return cache_db_filename


def generate_timestamp(moment):
    """
    Generates a timestamp for the given moment, formatted the way the API expects it.
    """

    now = datetime.datetime.now(datetime.timezone.utc).replace(second=0, microsecond=0)
    if moment == "twodaysago":
        timestamp = now - datetime.timedelta(days=2)
    else:  # moment = 'now'
        timestamp = now
    return timestamp.isoformat(timespec="milliseconds")


def init_cache_db():
    """
    Creates the database connection and creates the database tables when needed.
    Returns the database connection.
    """

    db_conn = sqlite3.connect(get_cache_db_filename())
    cursor = db_conn.cursor()

    # Create table AquoMetadataLijst
    cursor.execute(
        """CREATE TABLE IF NOT EXISTS AquoMetadataLijst (
        AquoMetadata_MessageID INTEGER PRIMARY KEY AUTOINCREMENT,
        Parameter_Wat_Omschrijving TEXT NOT NULL,
        Compartiment_Code TEXT NOT NULL,
        Compartiment_Omschrijving TEXT NOT NULL,
        Grootheid_Code TEXT NOT NULL,
        Grootheid_Omschrijving TEXT NOT NULL)
        """
    )

    # Create table LocatieLijst
    cursor.execute(
        """CREATE TABLE IF NOT EXISTS LocatieLijst (
        Locatie_MessageID INTEGER PRIMARY KEY AUTOINCREMENT,
        Coordinatenstelsel INTEGER,
        Naam TEXT NOT NULL,
        Code TEXT NOT NULL)
        """
    )

    # Create table AquoMetadataLocatieLijst
    cursor.execute(
        """CREATE TABLE IF NOT EXISTS AquoMetadataLocatieLijst (
        AquoMetaData_MessageID INTEGER,
        Locatie_MessageID INTEGER)
        """
    )

    db_conn.commit()

    return db_conn


def update_cache():
    """
    Pulls a list of all available data from the API and returns it in json format.
    """

    db_conn = init_cache_db()

    url = API + "METADATASERVICES/OphalenCatalogus"
    jsonbody = """{
        "CatalogusFilter": {
            "Compartimenten": true,
            "Grootheden": true
            }
        }"""
    catalog = post(url, json=json.loads(jsonbody), timeout=60).json()

    cursor = db_conn.cursor()

    cursor.execute("DELETE FROM AquoMetadataLijst;")
    cursor.execute("DELETE FROM LocatieLijst;")
    cursor.execute("DELETE FROM AquoMetadataLocatieLijst;")

    for item in catalog["AquoMetadataLijst"]:
        values = (
            item["AquoMetadata_MessageID"],
            item["Parameter_Wat_Omschrijving"],
            item["Compartiment"]["Code"],
            item["Compartiment"]["Omschrijving"],
            item["Grootheid"]["Code"],
            item["Grootheid"]["Omschrijving"],
        )
        cursor.execute("""
            INSERT INTO AquoMetadataLijst
            (AquoMetadata_MessageID, Parameter_Wat_Omschrijving, Compartiment_Code,
                Compartiment_Omschrijving, Grootheid_Code, Grootheid_Omschrijving)
            VALUES (?, ?, ?, ?, ?, ?)""", values)

    for item in catalog["LocatieLijst"]:
        values = (
            item["Locatie_MessageID"],
            item["Coordinatenstelsel"],
            item["Naam"],
            item["Code"],
        )
        cursor.execute("""
            INSERT INTO LocatieLijst
            (Locatie_MessageID, Coordinatenstelsel, Naam, Code)
            VALUES (?, ?, ?, ?)""", values)

    for item in catalog["AquoMetadataLocatieLijst"]:
        values = (item["AquoMetaData_MessageID"], item["Locatie_MessageID"])
        cursor.execute("""
            INSERT INTO AquoMetadataLocatieLijst
            (AquoMetaData_MessageID, Locatie_MessageID)
            VALUES (?, ?)""", values)

    db_conn.commit()
    db_conn.close()


def observe(arguments):
    """
    Queries the API for the latest data for the given location and measure.
    """

    db_conn = init_cache_db()
    cursor = db_conn.cursor()

    # Get the location id
    cursor.execute(
        "SELECT Code, Naam FROM LocatieLijst WHERE Code = ?;", (arguments.location,)
    )
    location_data = cursor.fetchone()
    if location_data is None:
        db_conn.close()
        sys.exit(f"Error: unknown location '{arguments.location}' (see: wtr list -c locations)")

    compartment = select_compartment(cursor, arguments)
    db_conn.close()

    # Get measurements
    url = API + "ONLINEWAARNEMINGENSERVICES/OphalenWaarnemingen"
    request_body = {
        "Locatie": {"Code": location_data[0]},
        "AquoPlusWaarnemingMetadata": {
            "AquoMetadata": {
                "Compartiment": {"Code": compartment},
                "Grootheid": {"Code": arguments.measure},
            }
        },
        "Periode": {
            "Begindatumtijd": generate_timestamp("twodaysago"),
            "Einddatumtijd": generate_timestamp("now"),
        },
    }
    response = post(url, json=request_body, timeout=60)

    # The API answers "204 No Content" with an empty body when there are no measurements
    if response.status_code == 204 or not response.content:
        print("No data available")
        return

    observations = response.json()
    if not observations["Succesvol"]:
        print("Error: " + observations["Foutmelding"])
        return

    series = select_series(observations["WaarnemingenLijst"])
    if series is None:
        print("No data available")
        return

    metadata = series["AquoMetadata"]
    indent = ""
    if not arguments.no_headers:
        indent = "  "
        print("#")
        print(f"# Description: {metadata['Parameter_Wat_Omschrijving']}")
        print(f"# Compartment: {metadata['Compartiment']['Code']} ({metadata['Compartiment']['Omschrijving']})")
        print(f"# Measure: {metadata['Grootheid']['Code']} ({metadata['Grootheid']['Omschrijving']})")
        print(f"# Location: {location_data[0]} ({location_data[1]})")
        print("#")
        print("# Timestamp                      Value")
    for item in series["MetingenLijst"][-arguments.rows :]:
        print(f"{indent}{item['Tijdstip']}  {item['Meetwaarde']['Waarde_Numeriek']}")


def select_compartment(cursor, arguments):
    """
    Chooses the compartment to query for the given location and measure. Many measures
    exist in more than one compartment (e.g. T: air and surface water). Prefers the
    --compartment argument, then surface water (OW), then the only one available.
    Exits with an error when the measure is not available at the location.
    """

    cursor.execute(
        """
        SELECT DISTINCT AquoMetadataLijst.Compartiment_Code
        FROM AquoMetadataLijst
        INNER JOIN AquoMetadataLocatieLijst ON AquoMetadataLijst.AquoMetadata_MessageID = AquoMetadataLocatieLijst.AquoMetaData_MessageID
        INNER JOIN LocatieLijst ON AquoMetadataLocatieLijst.Locatie_MessageID = LocatieLijst.Locatie_MessageID
        WHERE LocatieLijst.Code = ? AND AquoMetadataLijst.Grootheid_Code = ?
        ORDER BY AquoMetadataLijst.Compartiment_Code;
        """,
        (arguments.location, arguments.measure),
    )
    available = [row[0] for row in cursor.fetchall()]

    if not available:
        cursor.execute(
            "SELECT 1 FROM AquoMetadataLijst WHERE Grootheid_Code = ?;", (arguments.measure,)
        )
        if cursor.fetchone() is None:
            sys.exit(f"Error: unknown measure '{arguments.measure}' (see: wtr list -c measures)")
        sys.exit(
            f"Error: measure '{arguments.measure}' is not available at location "
            f"'{arguments.location}' (see: wtr list -c locations)"
        )

    if arguments.compartment:
        if arguments.compartment not in available:
            sys.exit(
                f"Error: compartment '{arguments.compartment}' is not available for measure "
                f"'{arguments.measure}' at location '{arguments.location}' "
                f"(available: {', '.join(available)})"
            )
        return arguments.compartment
    if "OW" in available:
        return "OW"
    if len(available) == 1:
        return available[0]
    sys.exit(
        f"Error: measure '{arguments.measure}' exists in several compartments at location "
        f"'{arguments.location}'; choose one with --compartment ({', '.join(available)})"
    )


def select_series(series_list):
    """
    Picks the series to show from the API reply. The API can return several series for
    the same measure, e.g. measurements ('meting') and forecasts ('verwachting').
    Prefers measurements; returns None when no series contains data.
    """

    with_data = [series for series in series_list if series["MetingenLijst"]]
    for series in with_data:
        if series["AquoMetadata"].get("ProcesType") == "meting":
            return series
    return with_data[0] if with_data else None


def list_cache(arguments):
    """
    Lists interesting objects from the catalog, based on the --category argument.
    """

    db_conn = init_cache_db()
    cursor = db_conn.cursor()

    if arguments.category == "locations":
        print("Location (Name): Compartment_Code (Description) - Measure (Description)")
        query = """
            SELECT Code, Naam, Compartiment_Code, Compartiment_Omschrijving,
                Grootheid_Code, Grootheid_Omschrijving
            FROM AquoMetadataLijst
            INNER JOIN AquoMetadataLocatieLijst ON AquoMetadataLijst.AquoMetadata_MessageID = AquoMetadataLocatieLijst.AquoMetaData_MessageID
            INNER JOIN LocatieLijst ON AquoMetadataLocatieLijst.Locatie_MessageID = LocatieLijst.Locatie_MessageID
            ORDER BY Code, Naam;
        """
        cursor.execute(query)
        for row in cursor.fetchall():
            print(f"{row[0]} ({row[1]}): {row[2]} ({row[3]}) - {row[4]} ({row[5]})")
    elif arguments.category == "measures":
        print("Compartment_Code (Description): Measure (Description) - Note")
        query = """
            SELECT Compartiment_Code, Compartiment_Omschrijving, Grootheid_Code,
                Grootheid_Omschrijving, Parameter_Wat_Omschrijving
            FROM AquoMetadataLijst
            ORDER BY Compartiment_Code, Grootheid_Code;
        """
        cursor.execute(query)
        for row in cursor.fetchall():
            print(f"{row[0]} ({row[1]}): {row[2]} ({row[3]}) - {row[4]}")
    else:
        print("Unknown category")


def parse_arguments():
    """
    Parses the command line arguments and returns the parsed arguments.
    """

    parser = argparse.ArgumentParser(
        description="wtr - Rijkswaterstaat Waterinfo API client " + VERSION + ".",
        epilog="Examples:\n  List of locations:\n    wtr list -c locations\n  Show the latest water height measurements at location Culemborg:\n    wtr observe -l culemborg -m WATHTE\n",
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument(
        "command",
        choices=["list", "observe", "update"],
        help="list: list objects from the cache\nobserve: observe a location\nupdate: updates the metadata cache",
    )
    parser.add_argument(
        "-c",
        "--category",
        default="locations",
        help="Category to query: locations (default), measures",
    )
    parser.add_argument(
        "-l",
        "--location",
        help="Filter by location code",
    )
    parser.add_argument(
        "-m",
        "--measure",
        default="WATHTE",
        help="Measure to query (default WATHTE)",
    )
    parser.add_argument(
        "--compartment",
        help="Compartment to query, e.g. OW (surface water) or LT (air);\ndefault: OW when available at the location",
    )
    parser.add_argument(
        "-r",
        "--rows",
        type=int,
        default=18,
        help="Number of rows to show (default 18)",
    )
    parser.add_argument(
        "--no-headers",
        action="store_true",
        default=False,
        help="Disable headers; just print the data",
    )

    arguments = parser.parse_args()
    if arguments.command == "observe" and not arguments.location:
        parser.error("observe requires a location, e.g. -l culemborg")
    if arguments.rows < 1:
        parser.error("--rows must be 1 or more")
    return arguments


if __name__ == "__main__":
    args = parse_arguments()

    if not os.path.isfile(get_cache_db_filename()):
        print("Caching metadata...")
        update_cache()

    if args.command == "list":
        list_cache(args)
    elif args.command == "observe":
        observe(args)
    elif args.command == "update":
        print("Updating metadata...")
        update_cache()
